<section class="sheet-header {{theme}}">
    <div class="tozsamosc">
    <h2>{{localize "LJ.lowca.tozsamosc"}}</h2>
    <div class="image-container">
        {{#if (not tokenDisplay)}}
            <img
                class="profile-img"
                src="{{@root.actor.img}}"
                data-edit="img"
                data-action="editImage"
                data-edit="img"
            />
        {{else}}
            <img
                class="profile-img"
                src="{{@root.tokenImg}}"
                data-action="editImage"
                data-edit="prototypeToken.texture.src"
            />
        {{/if}}
        <div class="toggle-wrapper">
            <span class="label">{{localize "LJ.lowca.obraz"}}</span>
            <label class="switch">
                <input type="checkbox" data-action="toggle" {{#if tokenDisplay}}checked{{/if}}>
                <span class="slider"></span>
            </label>
            <span class="label">{{localize "LJ.lowca.token"}}</span>
        </div>
    </div>
    <div class="dane-lowcy">
        <div class="flexrow">
            <label>{{localize "LJ.lowca.imie"}}</label>
            <input name="name" type="text" value="{{actor.name}}" />
        </div>
        <div class="flexrow">
            <label>{{localize "LJ.lowca.plemie"}}</label>
            {{formInput 
                systemFields.plemie
                value = system.plemie
            }}
        </div>
        <div class="flexrow">
            <label>{{localize "LJ.lowca.sciezka"}}</label>
            {{formInput 
                systemFields.sciezka
                value = system.sciezka
            }}
        </div>
    </div>
    </div>
    <div class="atrybuty">
        <h2>{{localize "LJ.lowca.atrybuty" }}</h2>
        <div class="cechy">
            {{#each systemFields.cechy.fields as |cecha|}}
            {{log cecha}}
                <div class="flexrow">
                    <a data-action="rzut_atrybut" data-atrybut="{{cecha.name}}">{{localize cecha.label}}</a>
                    {{formInput
                        cecha
                        value=(lookup @root.system.cechy cecha.name)
                        type="text"
                        localize = true
                    }}
                </div>
            {{/each}}
        </div>
    </div>
    <div class="dodatkowe">
        <div class="form-grup">
            <label>{{localize "LJ.lowca.kondycja"}}</label>
            <div class="flexrow three">
                {{formInput
                    systemFields.kondycja.fields.current
                    value = system.kondycja.current
                    type = "number"
                }}
                <p>/</p>
                {{formInput
                    systemFields.kondycja.fields.max
                    value = system.kondycja.max
                    type = "number"
                }}
            </div>
        </div>
        <div class="form-grup">
            <label>{{localize "LJ.lowca.rany"}}</label>
            <div class="flexrow three">
                {{formInput
                    systemFields.rany.fields.current
                    value = system.kondycja.current
                    type = "number"
                }}
                <p>/</p>
                {{formInput
                    systemFields.rany.fields.max
                    value = system.kondycja.max
                    type = "number"
                }}
            </div>
        </div>
                <div class="form-grup one">
            <label>{{localize systemFields.ruch.label}}</label>
            <div class="flexrow ">
                {{formInput
                    systemFields.ruch
                    value = system.ruch
                    type = "text"
                    localize = true
                }}
            </div>
        </div>
        <div class="form-grup one">
            <label>{{localize  systemFields.dziki_zeton.label}}</label>
            <div class="flexrow ">
                {{formInput
                    systemFields.dziki_zeton
                    value = system.dziki_zeton
                    type = "checkbox"
                }}
            </div>
        </div>
                <div class="form-grup one">
            <label>{{localize  systemFields.obrazenia.label}}</label>
            <div class="flexrow ">
                {{formInput
                    systemFields.obrazenia
                    value = system.obrazenia
                    type = "number"
                }}
            </div>
        </div>
                <div class="form-grup one">
            <label>{{localize  systemFields.pancerz.label}}</label>
            <div class="flexrow ">
                {{formInput
                    systemFields.pancerz
                    value = system.pancerz
                    type = "number"
                }}
            </div>
        </div>
    </div>
</section>