<section
  class="tab historia {{tabs.historia.cssClass}} {{theme}}"
  action-data="tab"
  data-tab="historia"
  data-group="items"
>
  <h2>{{localize "LJ.lowca.historia"}}</h2>

  <div class="form-group">
    <label>{{{localize historia.plemie.field.label}}}</label>
    {{formInput
      historia.plemie.field
      value=historia.plemie.value
      enriched=historia.plemie.enriched
      toggled="true"
    }}
  </div>

  <div class="form-group">
    <label>{{{localize historia.jak_zostales.field.label}}}</label>
    {{formInput
      historia.jak_zostales.field
      value=historia.jak_zostales.value
      enriched=historia.jak_zostales.enriched
      toggled="true"
    }}
  </div>

  <div class="form-group">
    <label>{{{localize historia.znany_lowca.field.label}}}</label>
    {{formInput
      historia.znany_lowca.field
      value=historia.znany_lowca.value
      enriched=historia.znany_lowca.enriched
      toggled="true"
    }}
  </div>
</section>