<section
  class="tab o_tobie {{tabs.o_tobie.cssClass}} {{theme}}"
  action-data="tab"
  data-tab="o_tobie"
  data-group="items"
>
  <h2>{{localize "LJ.lowca.o_tobie"}}</h2>

  <div class="form-group">
    <label>{{{localize o_tobie.strach.field.label}}}</label>
    {{formInput
      o_tobie.strach.field
      value=o_tobie.strach.value
      enriched=o_tobie.strach.enriched
      toggled="true"
    }}
  </div>

  <div class="form-group">
    <label>{{{localize o_tobie.marzenia.field.label}}}</label>
    {{formInput
      o_tobie.marzenia.field
      value=o_tobie.marzenia.value
      enriched=o_tobie.marzenia.enriched
      toggled="true"
    }}
  </div>

  <div class="form-group">
    <label>{{{localize o_tobie.cel.field.label}}}</label>
    {{formInput
      o_tobie.cel.field
      value=o_tobie.cel.value
      enriched=o_tobie.cel.enriched
      toggled="true"
    }}
  </div>
  <div class="form-group">
    <label>{{{localize o_tobie.cel.field.label}}}</label>
    {{formInput
      o_tobie.cel.field
      value=o_tobie.cel.value
      enriched=o_tobie.cel.enriched
      toggled="true"
    }}
  </div>
  <div class="form-group">
    <label>{{{localize o_tobie.zaufanie.field.label}}}</label>
    {{formInput
      o_tobie.zaufanie.field
      value=o_tobie.zaufanie.value
      enriched=o_tobie.zaufanie.enriched
      toggled="true"
    }}
  </div>
</section>